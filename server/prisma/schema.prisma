// SwiftLoan — data model, derived directly from the app flow.
// Postgres provider; the schema is written to scale (indexes, enums, UUID PKs,
// audit timestamps). Swap DATABASE_URL to point at any Postgres cluster.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & auth ───────────────────────────

enum Gender {
  male
  female
  other
}

enum ResidenceType {
  own
  rented
  family
  company
}

enum EmploymentType {
  salaried
  self_employed
  business_owner
  gig_worker
  student
  retired
  other
}

enum Lang {
  en
  hi
  te
  hinglish
  tenglish
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  fullName      String?
  dob           DateTime?
  gender        Gender?
  pincode       String?
  residenceType ResidenceType?
  employment    EmploymentType?
  monthlyIncome Int?
  company       String?
  panNumber     String?
  aadhaarLast4  String?
  lang          Lang      @default(en)
  creditScore   Int       @default(750)
  phoneVerified Boolean   @default(false)
  emailVerified Boolean   @default(false)
  memberVerified Boolean  @default(false)

  // notification preferences
  notifyLoanUpdates    Boolean @default(true)
  notifySecurityAlerts Boolean @default(true)
  notifyPromoOffers    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications LoanApplication[]
  loans        Loan[]
  kyc          KycVerification[]
  consents     Consent[]
  otps         OtpToken[]
  tickets      SupportTicket[]
  sessions     RefreshToken[]

  @@index([createdAt])
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  purpose   String   @default("login") // login | verify_phone
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ConsentType {
  terms
  soft_pull        // CIBIL / CRIF soft enquiry
  data_sharing     // share profile with lending partners
  communications   // language / marketing
}

model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  createdAt DateTime    @default(now())

  @@index([userId, type])
}

// ─────────────────────── Application funnel ───────────────────────

enum ApplicationStatus {
  draft            // Step 1 details captured
  pan_pending      // Step 2
  prequalifying    // "finding offers"
  offers_ready     // Step 3
  handoff          // Step 4 secure handoff
  under_review     // submitted to lender
  approved
  rejected
  disbursed
  closed
}

enum LoanType {
  personal
  business
  home
  education
  vehicle
}

model LoanApplication {
  id            String            @id @default(uuid())
  ref           String            @unique // e.g. SL-884021
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanType      LoanType          @default(personal)
  amount        Int
  tenureMonths  Int               @default(12)
  purpose       String?
  status        ApplicationStatus @default(draft)

  // snapshot of applicant details at submission
  employment    EmploymentType?
  monthlyIncome Int?
  residenceType ResidenceType?
  panNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]
  loan   Loan?
  kyc    KycVerification[]

  @@index([userId, status])
}

model LenderPartner {
  id           String  @id @default(uuid())
  name         String  @unique
  icon         String  @default("account_balance")
  baseApr      Float   // annual %
  tagline      String?
  processingFee Int    @default(0)
  active       Boolean @default(true)

  offers Offer[]
}

model Offer {
  id            String  @id @default(uuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       LenderPartner   @relation(fields: [partnerId], references: [id])
  amount        Int
  apr           Float
  emi           Int
  tenureMonths  Int
  processingFee Int
  tag           String?
  recommended   Boolean @default(false)
  selected      Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

// ────────────────────────── KYC ──────────────────────────

enum KycMethod {
  aadhaar
  pan
  bank
  selfie
}

enum KycStatus {
  pending
  verified
  failed
}

model KycVerification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  method        KycMethod
  status        KycStatus @default(pending)
  reference     String?   // masked id / doc ref
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, method, applicationId])
  @@index([userId])
}

// ─────────────────────── Loans & repayment ───────────────────────

enum LoanStatus {
  active
  closed
  defaulted
}

model Loan {
  id             String     @id @default(uuid())
  ref            String     @unique // e.g. SL-88429
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String     @unique
  application    LoanApplication @relation(fields: [applicationId], references: [id])
  partnerName    String
  principal      Int
  apr            Float
  tenureMonths   Int
  emiAmount      Int
  accountLast4   String     @default("4291")
  status         LoanStatus @default(active)
  disbursedAt    DateTime   @default(now())
  firstEmiDate   DateTime
  outstanding    Int

  repayments Repayment[]

  @@index([userId, status])
}

enum RepaymentStatus {
  scheduled
  paid
  pending
  late
}

model Repayment {
  id        String          @id @default(uuid())
  loanId    String
  loan      Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  ref       String          @unique
  amount    Int
  dueDate   DateTime
  paidDate  DateTime?
  status    RepaymentStatus @default(scheduled)
  createdAt DateTime        @default(now())

  @@index([loanId, status])
}

// ─────────────────────── Support / grievance ───────────────────────

enum TicketType {
  query
  grievance
}

enum TicketStatus {
  open
  in_progress
  resolved
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TicketType   @default(query)
  subject   String
  body      String?
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─────────────────────── Audit (scalability) ───────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  WS4 — Activity tracking + Admin dashboard  (ADDITIVE, new models only)
//  Nothing above this line is modified. These power /api/track and
//  /api/admin used by the admin/ Next.js dashboard.
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────── Session & event tracking ───────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String? // null = anonymous / pre-login session
  deviceInfo   Json? // { platform, osVersion, model, appVersion, ... }
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  pagesVisited Int       @default(0)
  durationSec  Int? // filled on session end

  // Drop-off tracking: the last screen the user was on and when they were last
  // active. If a session goes idle / never reaches a terminal screen, lastScreen
  // is where they dropped off. `reachedEnd` marks a session that completed the
  // funnel (so it is NOT counted as a drop-off).
  lastScreen   String? // most-recent route name seen in this session
  lastActiveAt DateTime? // updated on every navigation event
  reachedEnd   Boolean   @default(false) // hit a success/terminal screen

  events ActivityEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([lastScreen])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String?
  eventType String // navigation | action | funnel | system | error
  eventName String // snake_case, e.g. application_started, kyc_submitted
  screen    String? // route name the event fired on
  metadata  Json?
  ts        DateTime @default(now())

  @@index([userId, ts])
  @@index([eventName, ts])
  @@index([sessionId])
}

// ─────────────────────── Onboarding funnel ───────────────────────

enum StepStatus {
  started
  completed
  skipped
  abandoned
  failed
}

model OnboardingFunnel {
  id           String     @id @default(uuid())
  userId       String? // null for anonymous onboarding
  sessionId    String?
  stepNumber   Int
  stepName     String // language | mobile | otp | permissions | aboutyou | home
  status       StepStatus @default(started)
  timeSpentSec Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([stepNumber, status])
}

// ─────────────────────── Anonymous leads ───────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

model AnonymousLead {
  id              String     @id @default(uuid())
  name            String?
  phone           String?
  city            String?
  productInterest String?
  amount          Int? // paise
  source          String     @default("app") // widget | app | campaign | organic
  campaignId      String?
  referrer        String?
  status          LeadStatus @default(new)
  convertedUserId String? // set when the lead becomes a real User
  note            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

// ─────────────────────── App downloads / attribution ───────────────────────

model AppDownload {
  id            String   @id @default(uuid())
  platform      String // ios | android
  source        String   @default("organic") // organic | campaign | referral | partner
  campaignId    String?
  referrer      String?
  matchedUserId String? // filled when the install is attributed to a user
  contextLoaded Boolean  @default(false) // deferred deep-link context resolved on first open
  installedAt   DateTime @default(now())

  @@index([source])
  @@index([platform])
  @@index([installedAt])
}

// ─────────────────────── Admin users & notifications ───────────────────────

enum AdminRole {
  super_admin
  admin
  analyst
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(admin)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
}

enum NotificationSeverity {
  info
  success
  warning
  critical
}

model Notification {
  id        String               @id @default(uuid())
  type      String // loan_stale | onboarding_stale | new_lead | disbursed | system
  title     String
  body      String?
  severity  NotificationSeverity @default(info)
  entityId  String? // related loan/lead/user id for drill-down
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([read, createdAt])
  @@index([type])
}

// ─────────────────── WS3: context-aware install handoff ───────────────────
// Captures what a visitor told the website widget / voice agent, keyed by a
// short opaque token. The token (NOT the PII) travels in the app-download deep
// link; the context APK resolves it server-side on first open and the in-app
// agent continues the journey ("as we discussed, your ₹5L personal loan…").
model ContextSession {
  id         String    @id @default(uuid())
  token      String    @unique // short opaque code carried in the deep link
  name       String?
  phone      String?
  city       String?
  product    String? // Personal Loan | Business Loan
  amount     Int? // paise
  summary    String? // one-line of what the user said / wants
  source     String    @default("website") // website | call | widget
  transcript Json? // optional richer context (turns, fields captured)
  claimedAt  DateTime? // set when the app first resolves it
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}
