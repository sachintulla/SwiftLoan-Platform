// SwiftLoan — data model, derived directly from the app flow.
// Postgres provider; the schema is written to scale (indexes, enums, UUID PKs,
// audit timestamps). Swap DATABASE_URL to point at any Postgres cluster.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & auth ───────────────────────────

enum Gender {
  male
  female
  other
}

enum ResidenceType {
  own
  rented
  family
  company
}

enum EmploymentType {
  salaried
  self_employed
  business_owner
  gig_worker
  student
  retired
  other
}

enum Lang {
  en
  hi
  te
  hinglish
  tenglish
}

model User {
  id             String          @id @default(uuid())
  phone          String          @unique
  email          String?         @unique
  passwordHash   String?
  firstName      String?
  lastName       String?
  fullName       String?
  dob            DateTime?
  gender         Gender?
  pincode        String?
  residenceType  ResidenceType?
  employment     EmploymentType?
  monthlyIncome  Int?
  company        String?
  panNumber      String?
  aadhaarLast4   String?
  lang           Lang            @default(en)
  creditScore    Int             @default(750)
  phoneVerified  Boolean         @default(false)
  emailVerified  Boolean         @default(false)
  memberVerified Boolean         @default(false)

  // notification preferences
  notifyLoanUpdates    Boolean @default(true)
  notifySecurityAlerts Boolean @default(true)
  notifyPromoOffers    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications LoanApplication[]
  loans        Loan[]
  kyc          KycVerification[]
  consents     Consent[]
  otps         OtpToken[]
  tickets      SupportTicket[]
  sessions     RefreshToken[]

  @@index([createdAt])
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  purpose   String   @default("login") // login | verify_phone
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ConsentType {
  terms
  soft_pull // CIBIL / CRIF soft enquiry
  data_sharing // share profile with lending partners
  communications // language / marketing
}

model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  createdAt DateTime    @default(now())

  @@index([userId, type])
}

// ─────────────────────── Application funnel ───────────────────────

enum ApplicationStatus {
  draft // Step 1 details captured
  pan_pending // Step 2
  prequalifying // "finding offers"
  offers_ready // Step 3
  handoff // Step 4 secure handoff
  under_review // submitted to lender
  approved
  rejected
  disbursed
  closed
}

enum LoanType {
  personal
  business
  home
  education
  vehicle
}

model LoanApplication {
  id           String            @id @default(uuid())
  ref          String            @unique // e.g. SL-884021
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanType     LoanType          @default(personal)
  amount       Int
  tenureMonths Int               @default(12)
  purpose      String?
  status       ApplicationStatus @default(draft)

  // snapshot of applicant details at submission
  employment    EmploymentType?
  monthlyIncome Int?
  residenceType ResidenceType?
  panNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]
  loan   Loan?
  kyc    KycVerification[]

  @@index([userId, status])
}

model LenderPartner {
  id            String  @id @default(uuid())
  name          String  @unique
  icon          String  @default("account_balance")
  baseApr       Float // annual %
  tagline       String?
  processingFee Int     @default(0)
  active        Boolean @default(true)

  offers Offer[]
}

model Offer {
  id            String          @id @default(uuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       LenderPartner   @relation(fields: [partnerId], references: [id])
  amount        Int
  apr           Float
  emi           Int
  tenureMonths  Int
  processingFee Int
  tag           String?
  recommended   Boolean         @default(false)
  selected      Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

// ────────────────────────── KYC ──────────────────────────

enum KycMethod {
  aadhaar
  pan
  bank
  selfie
}

enum KycStatus {
  pending
  verified
  failed
}

model KycVerification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  method        KycMethod
  status        KycStatus        @default(pending)
  reference     String? // masked id / doc ref
  verifiedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, method, applicationId])
  @@index([userId])
}

// ─────────────────────── Loans & repayment ───────────────────────

enum LoanStatus {
  active
  closed
  defaulted
}

model Loan {
  id            String          @id @default(uuid())
  ref           String          @unique // e.g. SL-88429
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  partnerName   String
  principal     Int
  apr           Float
  tenureMonths  Int
  emiAmount     Int
  accountLast4  String          @default("4291")
  status        LoanStatus      @default(active)
  disbursedAt   DateTime        @default(now())
  firstEmiDate  DateTime
  outstanding   Int

  repayments Repayment[]

  @@index([userId, status])
}

enum RepaymentStatus {
  scheduled
  paid
  pending
  late
}

model Repayment {
  id        String          @id @default(uuid())
  loanId    String
  loan      Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  ref       String          @unique
  amount    Int
  dueDate   DateTime
  paidDate  DateTime?
  status    RepaymentStatus @default(scheduled)
  createdAt DateTime        @default(now())

  @@index([loanId, status])
}

// ─────────────────────── Support / grievance ───────────────────────

enum TicketType {
  query
  grievance
}

enum TicketStatus {
  open
  in_progress
  resolved
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TicketType   @default(query)
  subject   String
  body      String?
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─────────────────────── Audit (scalability) ───────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  WS4 — Activity tracking + Admin dashboard  (ADDITIVE, new models only)
//  Nothing above this line is modified. These power /api/track and
//  /api/admin used by the admin/ Next.js dashboard.
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────── Session & event tracking ───────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String? // null = anonymous / pre-login session
  deviceInfo   Json? // { platform, osVersion, model, appVersion, ... }
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  pagesVisited Int       @default(0)
  durationSec  Int? // filled on session end

  events ActivityEvent[]

  @@index([userId])
  @@index([startedAt])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String?
  eventType String // navigation | action | funnel | system | error
  eventName String // snake_case, e.g. application_started, kyc_submitted
  screen    String? // route name the event fired on
  metadata  Json?
  ts        DateTime @default(now())

  @@index([userId, ts])
  @@index([eventName, ts])
  @@index([sessionId])
}

// ─────────────────────── Onboarding funnel ───────────────────────

enum StepStatus {
  started
  completed
  skipped
  abandoned
  failed
}

model OnboardingFunnel {
  id           String     @id @default(uuid())
  userId       String? // null for anonymous onboarding
  sessionId    String?
  stepNumber   Int
  stepName     String // language | mobile | otp | permissions | aboutyou | home
  status       StepStatus @default(started)
  timeSpentSec Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([stepNumber, status])
}

// ─────────────────────── Anonymous leads ───────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

model AnonymousLead {
  id              String     @id @default(uuid())
  name            String?
  phone           String?
  city            String?
  productInterest String?
  amount          Int? // paise
  source          String     @default("app") // widget | app | campaign | organic
  campaignId      String?
  referrer        String?
  status          LeadStatus @default(new)
  convertedUserId String? // set when the lead becomes a real User
  note            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

// ─────────────────────── App downloads / attribution ───────────────────────

model AppDownload {
  id            String   @id @default(uuid())
  platform      String // ios | android
  source        String   @default("organic") // organic | campaign | referral | partner
  campaignId    String?
  referrer      String?
  matchedUserId String? // filled when the install is attributed to a user
  contextLoaded Boolean  @default(false) // deferred deep-link context resolved on first open
  installedAt   DateTime @default(now())

  @@index([source])
  @@index([platform])
  @@index([installedAt])
}

// ─────────────────────── Admin users & notifications ───────────────────────

enum AdminRole {
  super_admin
  admin
  analyst
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(admin)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  // ── WS6: account security ──
  /// Set on seeded/reset accounts; the UI blocks everything until cleared.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// Base32 TOTP secret. Present only once 2FA setup has begun.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  /// Hashed single-use recovery codes, so a lost device is not a lockout.
  totpRecoveryCodes  String[]  @default([])
  /// Drives idle logout without trusting the client's clock.
  lastActivityAt     DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]
  resetTokens   AdminPasswordReset[]
}

/// WS6 — who did what in the dashboard.
///
/// Campaigns dial real people and integration settings hold live API keys, so
/// "who paused this / who changed that key" has to be answerable after the fact.
model AdminAuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Kept alongside adminId so the record survives the account being deleted.
  adminEmail String?
  action     String // e.g. campaign.start, integration.update
  entity     String? // campaign | customer | integration | stallRule | admin
  entityId   String?
  method     String
  path       String
  status     Int
  ip         String?
  userAgent  String?
  /// Request body with secrets stripped.
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

/// WS6 — single-use password reset tokens.
model AdminPasswordReset {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Only the hash is stored; the raw token goes out in the reset link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model AdminRefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([adminId])
}

enum NotificationSeverity {
  info
  success
  warning
  critical
}

model Notification {
  id        String               @id @default(uuid())
  type      String // loan_stale | onboarding_stale | new_lead | disbursed | system
  title     String
  body      String?
  severity  NotificationSeverity @default(info)
  entityId  String? // related loan/lead/user id for drill-down
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([read, createdAt])
  @@index([type])
}

// ─────────────────── WS3: context-aware install handoff ───────────────────
// Captures what a visitor told the website widget / voice agent, keyed by a
// short opaque token. The token (NOT the PII) travels in the app-download deep
// link; the context APK resolves it server-side on first open and the in-app
// agent continues the journey ("as we discussed, your ₹5L personal loan…").
model ContextSession {
  id         String    @id @default(uuid())
  token      String    @unique // short opaque code carried in the deep link
  name       String?
  phone      String?
  city       String?
  product    String? // Personal Loan | Business Loan
  amount     Int? // paise
  summary    String? // one-line of what the user said / wants
  source     String    @default("website") // website | call | widget
  transcript Json? // optional richer context (turns, fields captured)
  claimedAt  DateTime? // set when the app first resolves it
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════
// WS5 — Unified customer journey (website / voice / app / campaigns)
//
// Additive only. Nothing above this line changes. ActivityEvent, Session and
// OnboardingFunnel keep serving the existing analytics pages unchanged; these
// models add the cross-channel identity spine those cannot provide.
// ══════════════════════════════════════════════════════════════════════

/// Canonical journey stages, in forward order. Customer.currentStage only ever
/// advances through this list, so an out-of-order event never regresses a stage.
enum JourneyStage {
  lead_captured
  contacted
  app_installed
  registered
  eligibility_checked
  offers_viewed
  offer_selected
  kyc_started
  kyc_completed
  application_submitted
  approved
  rejected
  disbursed
  lost
}

/// One row per human, across every channel. This is the identity spine: it is
/// what makes a website enquiry, an outbound call and in-app behaviour resolve
/// to the same person. `phone` is the natural join key, and needs no
/// normalisation: the website form validates a 10-digit number starting 6-9 and
/// the app OTP schema validates 10 digits, so string equality is safe.
model Customer {
  id             String       @id @default(uuid())
  phone          String?      @unique
  email          String?
  name           String?
  city           String?
  /// Set once at creation and never overwritten: "where did they come from".
  firstSource    String       @default("website") // website | campaign | app | phone_call | organic
  userId         String?      @unique // linked at OTP verify
  campaignId     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  referrer       String?
  currentStage   JourneyStage @default(lead_captured)
  stageEnteredAt DateTime     @default(now())
  firstSeenAt    DateTime     @default(now())
  /// Drives drop-off detection and re-engagement scans.
  lastActivityAt DateTime     @default(now())
  /// Set when a re-engagement nudge fires, so a scan cannot spam the customer.
  lastNudgedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events    JourneyEvent[]
  calls     CallAttempt[]
  campaigns CampaignContact[]

  @@index([currentStage, stageEnteredAt])
  @@index([lastActivityAt])
  @@index([campaignId])
  @@index([firstSource])
}

/// The narrative timeline a human reads on a customer record. Deliberately
/// distinct from ActivityEvent (raw telemetry: different cardinality, retention
/// and consumers). Both are written from recordJourneyEvent() so they cannot
/// drift apart.
model JourneyEvent {
  id         String        @id @default(uuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String // website | voice | app | campaign | admin | system
  name       String // canonical name from lib/journey.ts
  stage      JourneyStage? // the stage this event moved them into, if any
  screen     String?
  /// Never store a full PAN or Aadhaar here; redactMetadata() enforces that.
  metadata   Json?
  occurredAt DateTime      @default(now())

  @@index([customerId, occurredAt])
  @@index([name, occurredAt])
  @@index([channel, occurredAt])
}

// ─────────────────────── Outbound calling (Ello) ───────────────────────

enum CallStatus {
  queued
  dialing
  in_progress
  completed
  failed
  no_answer
  busy
  cancelled
}

enum CallOutcome {
  interested
  not_interested
  callback_requested
  wrong_number
  voicemail
  unreachable
  do_not_call
  installed_app
  other
}

/// One outbound call placed through Ello. Created when queued, then updated by
/// the Ello outcome webhook.
model CallAttempt {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  phone String

  /// Ello's own identifier, so an inbound webhook can find this row.
  providerCallId String?      @unique
  status         CallStatus   @default(queued)
  outcome        CallOutcome?
  /// Free-text disposition or summary returned by the agent.
  summary        String?
  transcript     Json?
  recordingUrl   String?
  durationSec    Int?
  answered       Boolean      @default(false)
  attempt        Int          @default(1)
  error          String?

  /// Raw webhook body, kept verbatim so provider-shape drift is debuggable.
  rawPayload Json?

  queuedAt    DateTime  @default(now())
  dialedAt    DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([customerId, queuedAt])
  @@index([campaignId, status])
  @@index([status])
}

// ─────────────────────── Campaigns ───────────────────────

enum CampaignStatus {
  draft
  running
  paused
  completed
  failed
}

/// A bulk outbound-calling campaign, seeded from an uploaded spreadsheet.
model Campaign {
  id     String         @id @default(uuid())
  name   String
  /// Short human code used for attribution; matches Customer.campaignId.
  code   String         @unique
  status CampaignStatus @default(draft)

  /// How many calls may be in flight at once for this campaign.
  concurrency   Int     @default(1)
  /// Ello agent that runs the calls; falls back to the integration default.
  assistantId   String?
  /// Display name of the chosen agent, cached so the UI need not re-query Ello.
  assistantName String?
  note          String?

  // ── Schedule ──────────────────────────────────────────────────────────
  /// When the campaign may begin dialling (date + time).
  startAt      DateTime?
  /// When it must stop entirely (date + time).
  endAt        DateTime?
  scheduleType CampaignScheduleType @default(one_time)

  /// Daily calling window, stored as minutes from local midnight so it is
  /// trivially comparable and free of DST/date arithmetic. 540 = 09:00,
  /// 1140 = 19:00. Interpreted in `timezone`.
  dailyStartMinute Int    @default(540)
  dailyEndMinute   Int    @default(1140)
  /// IANA zone the window and day-of-week are evaluated in.
  timezone         String @default("Asia/Kolkata")
  /// Allowed weekdays, 0=Sunday..6=Saturday. Empty means every day.
  daysOfWeek       Int[]  @default([])

  // ── Retry cadence ─────────────────────────────────────────────────────
  retryStrategy         RetryStrategy @default(once)
  /// Hard ceiling on attempts per contact, whatever the strategy.
  maxAttemptsPerContact Int           @default(1)
  /// Used by n_per_day / until_answered.
  attemptsPerDay        Int           @default(1)
  /// Used by every_n_days.
  retryIntervalDays     Int           @default(1)
  /// Minimum gap between two attempts on the same contact.
  retryIntervalMinutes  Int           @default(60)
  /// Stop attempting a contact once a call is answered.
  stopOnAnswer          Boolean       @default(true)

  /// Last time the scheduler processed this campaign (observability).
  lastRunAt DateTime?

  totalContacts Int @default(0)
  queuedCount   Int @default(0)
  calledCount   Int @default(0)
  failedCount   Int @default(0)

  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts CampaignContact[]
  calls    CallAttempt[]

  @@index([status])
  @@index([createdAt])
}

enum ContactState {
  pending
  queued
  called
  failed
  skipped
}

/// One spreadsheet row, deduped per campaign on phone.
model CampaignContact {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name    String?
  phone   String
  email   String?
  city    String?
  product String?
  amount  Int? // paise
  /// Any extra spreadsheet columns, preserved as uploaded.
  extra   Json?

  state ContactState @default(pending)
  error String?

  // ── Attempt tracking (drives the retry cadence) ───────────────────────
  /// Total attempts ever made for this contact.
  attempts       Int       @default(0)
  /// Attempts made on `attemptDayKey`; reset when the local day rolls over.
  attemptsToday  Int       @default(0)
  /// Local (campaign-timezone) YYYY-MM-DD the daily counter belongs to.
  /// Stored rather than derived so the reset needs no cron and no tz maths.
  attemptDayKey  String?
  lastAttemptAt  DateTime?
  /// Earliest moment the next attempt may be made; null means "eligible now".
  nextEligibleAt DateTime?
  /// Set once any call for this contact connects.
  answered       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, state])
  /// The scheduler's hot path: eligible contacts for a running campaign.
  @@index([campaignId, state, nextEligibleAt])
}

// ───────────────── Integration config + outbound dispatch ─────────────────

/// Admin-editable configuration for external providers (Ello, Upshot). Held in
/// the database rather than env so the dashboard can change endpoints and keys
/// without a redeploy. Secret values are write-only over the API: they are set
/// through the admin UI but never returned by a read.
model IntegrationConfig {
  id        String   @id @default(uuid())
  /// ello | upshot
  provider  String   @unique
  enabled   Boolean  @default(false)
  /// Non-secret settings: base urls, paths, assistant ids, field mappings.
  settings  Json     @default("{}")
  /// Secret values such as api keys. Never returned by the read API.
  secrets   Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum DispatchChannel {
  push
  whatsapp
  sms
  email
  voice
}

enum DispatchStatus {
  pending
  sent
  failed
  cancelled
}

/// A re-engagement message the dashboard decided to send. The mobile app never
/// decides this. Upshot is the delivery platform; this row is our own record of
/// the attempt, with retry and idempotency so the first outbound HTTP this
/// backend has ever made is not fire-and-forget.
model OutboundRequest {
  id             String          @id @default(uuid())
  customerId     String?
  channel        DispatchChannel
  /// upshot_user_upsert | upshot_event | ello_call
  kind           String
  /// Dedup key: one nudge per customer, stage and kind within a cooldown window.
  idempotencyKey String          @unique
  payload        Json
  status         DispatchStatus  @default(pending)
  attempts       Int             @default(0)
  lastError      String?
  providerRef    String?
  response       Json?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

// ══════════════════════════════════════════════════════════════════════
// WS5b — campaign scheduling
//
// Ello's own campaign API accepts only a name, an assistant, a CSV and a
// single `scheduleTime` — it cannot express a daily calling window, retry
// cadence or per-contact attempt caps. So the schedule lives here and our
// scheduler drives Ello one call at a time via POST /api/agents/{id}/calls.
// ══════════════════════════════════════════════════════════════════════

enum CampaignScheduleType {
  /// Runs once over the date range; each contact is attempted per the retry rule.
  one_time
  /// Repeats across the date range on the configured cadence.
  recurring
}

/// How often a contact may be re-attempted until they answer or the caps are hit.
enum RetryStrategy {
  /// Exactly one attempt per contact, ever.
  once
  /// Up to `attemptsPerDay` attempts each active day.
  n_per_day
  /// One attempt every `retryIntervalDays` days.
  every_n_days
  /// Keep attempting on every eligible slot until answered or maxAttempts is hit.
  until_answered
}

/// WS5d — "did the next step happen?" rules, editable from the dashboard.
///
/// A stage-level stall check was too coarse: "entered a phone number but never
/// verified the OTP" happens entirely inside one stage, so it was invisible.
/// Each rule watches for a step (`triggerEvent`) that was NOT followed by the
/// step it should lead to (`expectedEvent`) within `delayMinutes`, then fires a
/// named event into Upshot. The notification content itself is authored on the
/// Upshot dashboard — we only tell it what happened and to whom.
model StallRule {
  id              String          @id @default(uuid())
  /// Human label shown in the dashboard, e.g. "OTP requested but not verified".
  name            String
  /// Canonical JOURNEY_EVENTS name the customer already did.
  triggerEvent    String
  /// The event that would mean they moved on. Absence of it is the stall.
  expectedEvent   String
  /// How long to wait before deciding they are stuck.
  delayMinutes    Int             @default(15)
  /// Event name sent to Upshot; matched to a campaign on their dashboard.
  upshotEvent     String
  /// Informational — Upshot decides the real channel from the campaign.
  channel         DispatchChannel @default(push)
  /// Don't re-fire the same rule for the same customer inside this window.
  cooldownMinutes Int             @default(1440)
  enabled         Boolean         @default(true)
  /// Observability, so the dashboard can show whether a rule ever matches.
  lastFiredAt     DateTime?
  firedCount      Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([triggerEvent, expectedEvent])
  @@index([enabled])
}
