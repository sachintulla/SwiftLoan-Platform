// SwiftLoan — data model, derived directly from the app flow.
// Postgres provider; the schema is written to scale (indexes, enums, UUID PKs,
// audit timestamps). Swap DATABASE_URL to point at any Postgres cluster.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & auth ───────────────────────────

enum Gender {
  male
  female
  other
}

enum ResidenceType {
  own
  rented
  family
  company
}

enum EmploymentType {
  salaried
  self_employed
  business_owner
  gig_worker
  student
  retired
  other
}

enum Lang {
  en
  hi
  te
  hinglish
  tenglish
}

model User {
  id             String          @id @default(uuid())
  phone          String          @unique
  email          String?         @unique
  passwordHash   String?
  firstName      String?
  lastName       String?
  fullName       String?
  dob            DateTime?
  gender         Gender?
  pincode        String?
  residenceType  ResidenceType?
  employment     EmploymentType?
  monthlyIncome  Int?
  company        String?
  panNumber      String?
  aadhaarLast4   String?
  avatarUrl      String?

  // Aurix (Knight Fintech) integration: cached X-Aurix-Token (generated at OTP
  // verify) + the extra applicant fields the eligible_offers request requires
  // or accepts. Collected across the PAN/details/optional screens.
  aurixToken          String?
  aurixTokenExpiresAt DateTime?
  maritalStatus       String?
  qualification       String?
  alternateMobile     String?
  alternateEmail      String?
  addressLine1        String?
  addressLine2        String?
  landmark            String?
  city                String?
  district            String?
  state               String?
  loanPurpose         String?
  salaryMode          String?
  monthlyObligations  Int?
  professionalType    String?
  companyEmail        String?
  businessEmail       String?

  lang           Lang            @default(en)
  creditScore    Int             @default(750)
  phoneVerified  Boolean         @default(false)
  emailVerified  Boolean         @default(false)
  memberVerified Boolean         @default(false)

  // notification preferences
  notifyLoanUpdates    Boolean @default(true)
  notifySecurityAlerts Boolean @default(true)
  notifyPromoOffers    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications LoanApplication[]
  loans        Loan[]
  kyc          KycVerification[]
  consents     Consent[]
  otps         OtpToken[]
  tickets      SupportTicket[]
  sessions     RefreshToken[]

  @@index([createdAt])
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  purpose   String   @default("login") // login | verify_phone
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ConsentType {
  terms
  soft_pull // CIBIL / CRIF soft enquiry
  data_sharing // share profile with lending partners
  communications // language / marketing
}

model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  createdAt DateTime    @default(now())

  @@index([userId, type])
}

// ─────────────────────── Application funnel ───────────────────────

enum ApplicationStatus {
  draft // Step 1 details captured
  pan_pending // Step 2
  prequalifying // "finding offers"
  offers_ready // Step 3
  handoff // Step 4 secure handoff
  under_review // submitted to lender
  approved
  rejected
  disbursed
  closed
}

enum LoanType {
  personal
  business
  home
  education
  vehicle
}

model LoanApplication {
  id           String            @id @default(uuid())
  ref          String            @unique // e.g. SL-884021
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanType     LoanType          @default(personal)
  amount       Int
  tenureMonths Int               @default(12)
  purpose      String?
  status       ApplicationStatus @default(draft)

  // snapshot of applicant details at submission
  employment    EmploymentType?
  monthlyIncome Int?
  residenceType ResidenceType?
  panNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]
  loan   Loan?
  kyc    KycVerification[]

  @@index([userId, status])
}

model LenderPartner {
  id            String  @id @default(uuid())
  name          String  @unique
  icon          String  @default("account_balance")
  baseApr       Float // annual %
  tagline       String?
  processingFee Int     @default(0) // legacy flat fee — kept for backward compat, prefer processingFeePercent
  active        Boolean @default(true)

  logoUrl              String?
  rating               Float?
  rbiApproved          Boolean  @default(true)
  minAmount            Int?
  maxAmount            Int?
  processingFeePercent Float?
  disbursalTimeHrs     Int?
  features             String[] @default([])

  // Forward-looking only — unused until a real lender is wired up. Mirrors
  // IntegrationConfig's provider/settings shape (see src/lib/integrations.ts)
  // so swapping the mock for a real adapter is a config change, not a schema one.
  provider  String @default("mock")
  apiConfig Json?

  offers Offer[]
}

// Admin-curated, pre-application eligibility catalog shown on the app's
// "Explore your loan options" screen (skip-login path) — distinct from Offer,
// which is computed per-application after a user actually applies.
/// The static catalog of market-available loan offers shown on the dashboard
/// after login (no PAN, no credit pull). NOT the personalised/eligible offers —
/// those are the Offer rows returned per application by the lender (Aurix).
/// Physical table kept as "PreApprovedPlan" (@@map) so the rename needs no
/// data migration.
model MarketLoanOffer {
  id         String  @id @default(uuid())
  lenderName String
  logoUrl    String? // hosted brand logo image URL
  icon       String  @default("account_balance") // fallback glyph if no logo set
  exploreUrl String? // opened in-browser from the "Explore Plan" button (demo)

  badge String? // e.g. "Best rate"

  maxAmount        Int? // "Up to ₹X", in paise; null if amountAtApproval
  amountAtApproval Boolean @default(false) // e.g. MoneyView: no amount shown

  rateMin        Float?
  rateMax        Float?
  rateAtApproval Boolean @default(false) // e.g. UnitySFB: "Rate at approval"

  tenureMinMonths Int?
  tenureMaxMonths Int?

  tags String[] // free-text pills for outlier cards

  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("PreApprovedPlan")
}

model Offer {
  id            String          @id @default(uuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       LenderPartner   @relation(fields: [partnerId], references: [id])
  // Denormalized copy of the recommended OfferEmiOption (or whichever option
  // the user actually picks at /select) — kept so /handoff can build Loan +
  // Repayment off these scalars without joining emiOptions.
  amount        Int
  apr           Float
  emi           Int
  tenureMonths  Int
  processingFee Int
  tag           String?
  recommended   Boolean         @default(false)
  selected      Boolean         @default(false)
  createdAt     DateTime        @default(now())

  badgeText           String?
  processingFeeAmount Int     @default(0)
  gstOnProcessingFee  Int     @default(0)
  netDisbursalAmount  Int     @default(0)

  // Aurix (Knight Fintech) eligible_offers response fields. A single Aurix call
  // returns many offers (one per real lender), so these are persisted per Offer
  // row alongside the denormalized scalars above. Kept for a later step that
  // surfaces them on the tiles; `rawOffer` preserves the untouched provider
  // object so nothing is lost.
  offerCode         String?
  offerType         String?
  roi               Float?
  offerLikelihood   String?
  redirectionUrl    String?
  lenderName        String?
  lenderLogoUrl     String?
  externalPartnerId String?
  rawOffer          Json?

  emiOptions OfferEmiOption[]

  @@index([applicationId])
}

// One row per tenure choice offered for a given Offer — lets a single lender
// offer present several EMI/tenure combinations (per the sample lender-API
// response this mirrors) instead of the single flat tenure Offer itself has.
model OfferEmiOption {
  id                   String  @id @default(uuid())
  offerId              String
  offer                Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenureMonths         Int
  monthlyEmi           Int
  totalInterestPayable Int
  totalRepaymentAmount Int
  recommended          Boolean @default(false)

  @@index([offerId])
}

// ────────────────────────── KYC ──────────────────────────

enum KycMethod {
  aadhaar
  pan
  bank
  selfie
}

enum KycStatus {
  pending
  verified
  failed
}

model KycVerification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  method        KycMethod
  status        KycStatus        @default(pending)
  reference     String? // masked id / doc ref
  verifiedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, method, applicationId])
  @@index([userId])
}

// ─────────────────────── Loans & repayment ───────────────────────

enum LoanStatus {
  active
  closed
  defaulted
}

model Loan {
  id            String          @id @default(uuid())
  ref           String          @unique // e.g. SL-88429
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  partnerName   String
  principal     Int
  apr           Float
  tenureMonths  Int
  emiAmount     Int
  accountLast4  String          @default("4291")
  status        LoanStatus      @default(active)
  disbursedAt   DateTime        @default(now())
  firstEmiDate  DateTime
  outstanding   Int

  repayments Repayment[]

  @@index([userId, status])
}

enum RepaymentStatus {
  scheduled
  paid
  pending
  late
}

model Repayment {
  id        String          @id @default(uuid())
  loanId    String
  loan      Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  ref       String          @unique
  amount    Int
  dueDate   DateTime
  paidDate  DateTime?
  status    RepaymentStatus @default(scheduled)
  createdAt DateTime        @default(now())

  @@index([loanId, status])
}

// ─────────────────────── Support / grievance ───────────────────────

enum TicketType {
  query
  grievance
}

enum TicketStatus {
  open
  in_progress
  resolved
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TicketType   @default(query)
  subject   String
  body      String?
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─────────────────────── Audit (scalability) ───────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  WS4 — Activity tracking + Admin dashboard  (ADDITIVE, new models only)
//  Nothing above this line is modified. These power /api/track and
//  /api/admin used by the admin/ Next.js dashboard.
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────── Session & event tracking ───────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String? // null = anonymous / pre-login session
  deviceInfo   Json? // { platform, osVersion, model, appVersion, ... }
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  pagesVisited Int       @default(0)
  durationSec  Int? // filled on session end

  events ActivityEvent[]

  @@index([userId])
  @@index([startedAt])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String?
  eventType String // navigation | action | funnel | system | error
  eventName String // snake_case, e.g. application_started, kyc_submitted
  screen    String? // route name the event fired on
  metadata  Json?
  ts        DateTime @default(now())

  @@index([userId, ts])
  @@index([eventName, ts])
  @@index([sessionId])
}

// ─────────────────────── Onboarding funnel ───────────────────────

enum StepStatus {
  started
  completed
  skipped
  abandoned
  failed
}

model OnboardingFunnel {
  id           String     @id @default(uuid())
  userId       String? // null for anonymous onboarding
  sessionId    String?
  stepNumber   Int
  stepName     String // language | mobile | otp | permissions | aboutyou | home
  status       StepStatus @default(started)
  timeSpentSec Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([stepNumber, status])
}

// ─────────────────────── Anonymous leads ───────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

model AnonymousLead {
  id              String     @id @default(uuid())
  name            String?
  phone           String?
  city            String?
  productInterest String?
  amount          Int? // paise
  source          String     @default("app") // widget | app | campaign | organic
  campaignId      String?
  referrer        String?
  status          LeadStatus @default(new)
  convertedUserId String? // set when the lead becomes a real User
  note            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

// ─────────────────────── App downloads / attribution ───────────────────────

model AppDownload {
  id            String   @id @default(uuid())
  platform      String // ios | android
  source        String   @default("organic") // organic | campaign | referral | partner
  campaignId    String?
  referrer      String?
  matchedUserId String? // filled when the install is attributed to a user
  contextLoaded Boolean  @default(false) // deferred deep-link context resolved on first open
  installedAt   DateTime @default(now())

  @@index([source])
  @@index([platform])
  @@index([installedAt])
}

// ─────────────────────── Admin users & notifications ───────────────────────

enum AdminRole {
  super_admin
  admin
  analyst
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(admin)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  // ── WS6: account security ──
  /// Set on seeded/reset accounts; the UI blocks everything until cleared.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// Base32 TOTP secret. Present only once 2FA setup has begun.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  /// Hashed single-use recovery codes, so a lost device is not a lockout.
  totpRecoveryCodes  String[]  @default([])
  /// Drives idle logout without trusting the client's clock.
  lastActivityAt     DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]
  resetTokens   AdminPasswordReset[]
}

/// WS6 — who did what in the dashboard.
///
/// Campaigns dial real people and integration settings hold live API keys, so
/// "who paused this / who changed that key" has to be answerable after the fact.
model AdminAuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Kept alongside adminId so the record survives the account being deleted.
  adminEmail String?
  action     String // e.g. campaign.start, integration.update
  entity     String? // campaign | customer | integration | stallRule | admin
  entityId   String?
  method     String
  path       String
  status     Int
  ip         String?
  userAgent  String?
  /// Request body with secrets stripped.
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

/// WS6 — single-use password reset tokens.
model AdminPasswordReset {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Only the hash is stored; the raw token goes out in the reset link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model AdminRefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([adminId])
}

enum NotificationSeverity {
  info
  success
  warning
  critical
}

model Notification {
  id        String               @id @default(uuid())
  type      String // loan_stale | onboarding_stale | new_lead | disbursed | system
  title     String
  body      String?
  severity  NotificationSeverity @default(info)
  entityId  String? // related loan/lead/user id for drill-down
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([read, createdAt])
  @@index([type])
}

// ─────────────────── WS3: context-aware install handoff ───────────────────
// Captures what a visitor told the website widget / voice agent, keyed by a
// short opaque token. The token (NOT the PII) travels in the app-download deep
// link; the context APK resolves it server-side on first open and the in-app
// agent continues the journey ("as we discussed, your ₹5L personal loan…").
model ContextSession {
  id         String    @id @default(uuid())
  token      String    @unique // short opaque code carried in the deep link
  name       String?
  phone      String?
  city       String?
  product    String? // Personal Loan | Business Loan
  amount     Int? // paise
  summary    String? // one-line of what the user said / wants
  source     String    @default("website") // website | call | widget
  transcript Json? // optional richer context (turns, fields captured)
  claimedAt  DateTime? // set when the app first resolves it
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════
// WS5 — Unified customer journey (website / voice / app / campaigns)
//
// Additive only. Nothing above this line changes. ActivityEvent, Session and
// OnboardingFunnel keep serving the existing analytics pages unchanged; these
// models add the cross-channel identity spine those cannot provide.
// ══════════════════════════════════════════════════════════════════════

/// Canonical journey stages, in forward order. Customer.currentStage only ever
/// advances through this list, so an out-of-order event never regresses a stage.
enum JourneyStage {
  lead_captured
  contacted
  app_installed
  registered
  eligibility_checked
  offers_viewed
  offer_selected
  kyc_started
  kyc_completed
  application_submitted
  approved
  rejected
  disbursed
  lost
}

/// One row per human, across every channel. This is the identity spine: it is
/// what makes a website enquiry, an outbound call and in-app behaviour resolve
/// to the same person. `phone` is the natural join key, and needs no
/// normalisation: the website form validates a 10-digit number starting 6-9 and
/// the app OTP schema validates 10 digits, so string equality is safe.
model Customer {
  id             String       @id @default(uuid())
  phone          String?      @unique
  email          String?
  name           String?
  city           String?
  /// Set once at creation and never overwritten: "where did they come from".
  firstSource    String       @default("website") // website | campaign | app | phone_call | organic
  userId         String?      @unique // linked at OTP verify
  campaignId     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  referrer       String?
  currentStage   JourneyStage @default(lead_captured)
  stageEnteredAt DateTime     @default(now())
  firstSeenAt    DateTime     @default(now())
  /// Drives drop-off detection and re-engagement scans.
  lastActivityAt DateTime     @default(now())
  /// Set when a re-engagement nudge fires, so a scan cannot spam the customer.
  lastNudgedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events        JourneyEvent[]
  calls         CallAttempt[]
  conversations Conversation[]
  campaigns     CampaignContact[]

  @@index([currentStage, stageEnteredAt])
  @@index([lastActivityAt])
  @@index([campaignId])
  @@index([firstSource])
}

/// The narrative timeline a human reads on a customer record. Deliberately
/// distinct from ActivityEvent (raw telemetry: different cardinality, retention
/// and consumers). Both are written from recordJourneyEvent() so they cannot
/// drift apart.
model JourneyEvent {
  id         String        @id @default(uuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String // website | voice | app | campaign | admin | system
  name       String // canonical name from lib/journey.ts
  stage      JourneyStage? // the stage this event moved them into, if any
  screen     String?
  /// Never store a full PAN or Aadhaar here; redactMetadata() enforces that.
  metadata   Json?
  occurredAt DateTime      @default(now())

  @@index([customerId, occurredAt])
  @@index([name, occurredAt])
  @@index([channel, occurredAt])
}

// ─────────────────────── Outbound calling (Ello) ───────────────────────

enum CallStatus {
  queued
  dialing
  in_progress
  completed
  failed
  no_answer
  busy
  cancelled
}

/// WS10 — one conversation with one person, on ANY channel.
///
/// Why this exists separately from CallAttempt: CallAttempt only models an
/// *outbound telephone call we placed*. It has no room for a website-widget
/// session, an in-app voice session, or an inbound call — and until now those
/// were never persisted at all, so a person could talk to three of our agents
/// and the fourth would greet them as a stranger.
///
/// Keyed on `phone` (bare 10 digits) as well as customerId, because that is the
/// only identifier every channel shares, and because an agent asking "what do we
/// know about this number?" has nothing else to ask with.
model Conversation {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Bare 10-digit Indian mobile. The cross-channel join key.
  phone      String

  /// Which surface this happened on.
  /// phone_outbound | phone_inbound | website_widget | mobile_app | admin
  channel                String
  /// Which agent role handled it (leadCallback, campaign, companion,
  /// websiteCompanion, adminNavigator) — null for non-agent conversations.
  agentRole              String?
  /// Ello's conversation_id, so a late webhook can find this row.
  providerConversationId String? @unique
  /// Set when this conversation was an outbound call we placed.
  callAttemptId          String?

  /// Human-readable recap. This is what the next agent actually reads.
  summary       String?
  /// Structured turns, whatever shape the provider gave us.
  transcript    Json?
  outcome       CallOutcome?
  /// "agent" (reported) | "inferred" (guessed from transcript) | "status" | null.
  /// Same provenance rule as CallAttempt: a guess must never read as a fact.
  outcomeSource String?
  /// Anything the agent captured — income, employment, preferred channel…
  details       Json?
  recordingUrl  String?

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone, startedAt])
  @@index([customerId, startedAt])
  @@index([channel, startedAt])
}

/// WS10 — the rolling cross-channel brief for one phone number.
///
/// Denormalised on purpose. Every agent fetches this at the START of every
/// conversation, so it must be one indexed read, not an aggregation over the
/// whole Conversation history while a customer waits on the line.
model ConversationSummary {
  /// Bare 10-digit phone — the primary key, since this is per-number.
  phone      String  @id
  customerId String?

  /// One paragraph covering everything across every channel. What the agent reads.
  summary           String
  /// Count and span, for the dashboard list.
  conversationCount Int          @default(0)
  channels          String[]     @default([])
  firstAt           DateTime?
  lastAt            DateTime?
  /// Channel and agent of the most recent conversation.
  lastChannel       String?
  lastAgentRole     String?
  /// Most recent known outcome, with its provenance.
  lastOutcome       CallOutcome?
  lastOutcomeSource String?

  updatedAt DateTime @updatedAt

  @@index([lastAt])
}

enum CallOutcome {
  interested
  not_interested
  callback_requested
  wrong_number
  voicemail
  unreachable
  do_not_call
  installed_app
  other
}

/// One outbound call placed through Ello. Created when queued, then updated by
/// the Ello outcome webhook.
model CallAttempt {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  phone String

  /// Ello's own identifier, so an inbound webhook can find this row.
  providerCallId  String?      @unique
  status          CallStatus   @default(queued)
  outcome         CallOutcome?
  /// How `outcome` was determined: "agent" (the agent reported it via the
  /// report_call_outcome tool), "inferred" (matched from the transcript — a
  /// guess), "status" (derived from a failure status), or null. Ello sends no
  /// outcome field, so without this an operator cannot tell a real disposition
  /// from a keyword match, and the two carry very different confidence.
  outcomeSource   String?
  /// The phrase that triggered an inference, so the dashboard can show its work.
  outcomeEvidence String?
  /// Free-text disposition or summary returned by the agent.
  summary         String?

  // ── Details the agent captured on the call (all optional; only ever set
  // from an explicit agent report, never inferred) ──────────────────────
  incomeRange      String?
  employment       String?
  preferredChannel String?
  /// When the customer asked to be called back.
  callbackAt       DateTime?
  /// The context_data variables sent to the agent for this call. Kept so an
  /// operator can see exactly what the agent knew when it dialled — the usual
  /// first question when a call goes wrong.
  callContext      Json?
  transcript       Json?
  recordingUrl     String?
  durationSec      Int?
  answered         Boolean   @default(false)
  attempt          Int       @default(1)
  error            String?

  /// Raw webhook body, kept verbatim so provider-shape drift is debuggable.
  rawPayload Json?

  queuedAt    DateTime  @default(now())
  dialedAt    DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([customerId, queuedAt])
  @@index([campaignId, status])
  @@index([status])
}

// ─────────────────────── Campaigns ───────────────────────

enum CampaignStatus {
  draft
  running
  paused
  completed
  failed
}

/// A bulk outbound-calling campaign, seeded from an uploaded spreadsheet.
model Campaign {
  id     String         @id @default(uuid())
  name   String
  /// Short human code used for attribution; matches Customer.campaignId.
  code   String         @unique
  status CampaignStatus @default(draft)

  /// How many calls may be in flight at once for this campaign.
  concurrency   Int     @default(1)
  /// Ello agent that runs the calls; falls back to the integration default.
  assistantId   String?
  /// Display name of the chosen agent, cached so the UI need not re-query Ello.
  assistantName String?
  note          String?

  // ── Schedule ──────────────────────────────────────────────────────────
  /// When the campaign may begin dialling (date + time).
  startAt      DateTime?
  /// When it must stop entirely (date + time).
  endAt        DateTime?
  scheduleType CampaignScheduleType @default(one_time)

  /// Daily calling window, stored as minutes from local midnight so it is
  /// trivially comparable and free of DST/date arithmetic. 540 = 09:00,
  /// 1140 = 19:00. Interpreted in `timezone`.
  dailyStartMinute Int    @default(540)
  dailyEndMinute   Int    @default(1140)
  /// IANA zone the window and day-of-week are evaluated in.
  timezone         String @default("Asia/Kolkata")
  /// Allowed weekdays, 0=Sunday..6=Saturday. Empty means every day.
  daysOfWeek       Int[]  @default([])

  // ── Retry cadence ─────────────────────────────────────────────────────
  retryStrategy         RetryStrategy @default(once)
  /// Hard ceiling on attempts per contact, whatever the strategy.
  maxAttemptsPerContact Int           @default(1)
  /// Used by n_per_day / until_answered.
  attemptsPerDay        Int           @default(1)
  /// Used by every_n_days.
  retryIntervalDays     Int           @default(1)
  /// Minimum gap between two attempts on the same contact.
  retryIntervalMinutes  Int           @default(60)
  /// Stop attempting a contact once a call is answered.
  stopOnAnswer          Boolean       @default(true)

  /// Last time the scheduler processed this campaign (observability).
  lastRunAt DateTime?

  totalContacts Int @default(0)
  queuedCount   Int @default(0)
  calledCount   Int @default(0)
  failedCount   Int @default(0)

  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts CampaignContact[]
  calls    CallAttempt[]

  @@index([status])
  @@index([createdAt])
}

enum ContactState {
  pending
  queued
  called
  failed
  skipped
}

/// One spreadsheet row, deduped per campaign on phone.
model CampaignContact {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name    String?
  phone   String
  email   String?
  city    String?
  product String?
  amount  Int? // paise
  /// Any extra spreadsheet columns, preserved as uploaded.
  extra   Json?

  state ContactState @default(pending)
  error String?

  // ── Attempt tracking (drives the retry cadence) ───────────────────────
  /// Total attempts ever made for this contact.
  attempts       Int       @default(0)
  /// Attempts made on `attemptDayKey`; reset when the local day rolls over.
  attemptsToday  Int       @default(0)
  /// Local (campaign-timezone) YYYY-MM-DD the daily counter belongs to.
  /// Stored rather than derived so the reset needs no cron and no tz maths.
  attemptDayKey  String?
  lastAttemptAt  DateTime?
  /// Earliest moment the next attempt may be made; null means "eligible now".
  nextEligibleAt DateTime?
  /// Set once any call for this contact connects.
  answered       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, state])
  /// The scheduler's hot path: eligible contacts for a running campaign.
  @@index([campaignId, state, nextEligibleAt])
}

// ───────────────── Integration config + outbound dispatch ─────────────────

/// Admin-editable configuration for external providers (Ello, Upshot). Held in
/// the database rather than env so the dashboard can change endpoints and keys
/// without a redeploy. Secret values are write-only over the API: they are set
/// through the admin UI but never returned by a read.
model IntegrationConfig {
  id        String   @id @default(uuid())
  /// ello | upshot
  provider  String   @unique
  enabled   Boolean  @default(false)
  /// Non-secret settings: base urls, paths, assistant ids, field mappings.
  settings  Json     @default("{}")
  /// Secret values such as api keys. Never returned by the read API.
  secrets   Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum DispatchChannel {
  push
  whatsapp
  sms
  email
  voice
}

enum DispatchStatus {
  pending
  sent
  failed
  cancelled
}

/// A re-engagement message the dashboard decided to send. The mobile app never
/// decides this. Upshot is the delivery platform; this row is our own record of
/// the attempt, with retry and idempotency so the first outbound HTTP this
/// backend has ever made is not fire-and-forget.
model OutboundRequest {
  id             String          @id @default(uuid())
  customerId     String?
  channel        DispatchChannel
  /// upshot_user_upsert | upshot_event | ello_call
  kind           String
  /// Dedup key: one nudge per customer, stage and kind within a cooldown window.
  idempotencyKey String          @unique
  payload        Json
  status         DispatchStatus  @default(pending)
  attempts       Int             @default(0)
  lastError      String?
  providerRef    String?
  response       Json?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

// ══════════════════════════════════════════════════════════════════════
// WS5b — campaign scheduling
//
// Ello's own campaign API accepts only a name, an assistant, a CSV and a
// single `scheduleTime` — it cannot express a daily calling window, retry
// cadence or per-contact attempt caps. So the schedule lives here and our
// scheduler drives Ello one call at a time via POST /api/agents/{id}/calls.
// ══════════════════════════════════════════════════════════════════════

enum CampaignScheduleType {
  /// Runs once over the date range; each contact is attempted per the retry rule.
  one_time
  /// Repeats across the date range on the configured cadence.
  recurring
}

/// How often a contact may be re-attempted until they answer or the caps are hit.
enum RetryStrategy {
  /// Exactly one attempt per contact, ever.
  once
  /// Up to `attemptsPerDay` attempts each active day.
  n_per_day
  /// One attempt every `retryIntervalDays` days.
  every_n_days
  /// Keep attempting on every eligible slot until answered or maxAttempts is hit.
  until_answered
}

/// WS5d — "did the next step happen?" rules, editable from the dashboard.
///
/// A stage-level stall check was too coarse: "entered a phone number but never
/// verified the OTP" happens entirely inside one stage, so it was invisible.
/// Each rule watches for a step (`triggerEvent`) that was NOT followed by the
/// step it should lead to (`expectedEvent`) within `delayMinutes`, then fires a
/// named event into Upshot. The notification content itself is authored on the
/// Upshot dashboard — we only tell it what happened and to whom.
model StallRule {
  id              String          @id @default(uuid())
  /// Human label shown in the dashboard, e.g. "OTP requested but not verified".
  name            String
  /// Canonical JOURNEY_EVENTS name the customer already did.
  triggerEvent    String
  /// The event that would mean they moved on. Absence of it is the stall.
  expectedEvent   String
  /// How long to wait before deciding they are stuck.
  delayMinutes    Int             @default(15)
  /// Event name sent to Upshot; matched to a campaign on their dashboard.
  upshotEvent     String
  /// Informational — Upshot decides the real channel from the campaign.
  channel         DispatchChannel @default(push)
  /// Don't re-fire the same rule for the same customer inside this window.
  cooldownMinutes Int             @default(1440)
  enabled         Boolean         @default(true)
  /// Observability, so the dashboard can show whether a rule ever matches.
  lastFiredAt     DateTime?
  firedCount      Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Channel is part of the key so the SAME drop-off can have both a push rule
  /// and a (later, longer-cooldown) voice rule — push at 15 minutes, call at 45 if
  /// they still have not moved. With the old two-column key the voice rule
  /// collided with the push one and could never be created.
  @@unique([triggerEvent, expectedEvent, channel])
  @@index([enabled])
}
