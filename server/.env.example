# For LOCAL dev only. The deployed boxes get these from GitHub Actions repo
# Variables/Secrets (Settings > Secrets and variables > Actions, prefixed
# SERVER_* for config, unprefixed for DATABASE_URL/JWT_*_SECRET), passed via
# `-e` in .github/workflows/deploy*.yml — update values there, not by editing
# a .env file on a box (that file silently drifted out of sync before).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/swiftloan_db?schema=public"
PORT=4000
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
ACCESS_TTL="900"
REFRESH_TTL_DAYS="30"
NODE_ENV="development"

# OTP SMS delivery. Unset/none = OTP is surfaced in the API response for local
# dev only (see DEMO_LOGIN below). Set SMS_PROVIDER to send real SMS and stop
# surfacing the code entirely.
# SMS_PROVIDER="vox"             # or "msg91"
# MSG91_AUTHKEY=""
# MSG91_TEMPLATE_ID=""
# Vox Digitals CPaaS (India, DLT). The credential is a PAIR — both halves are
# required or every OTP comes back 1401. VOX_SENDER must be the 6-char header
# registered on the DLT portal and VOX_TEMPLATE_TEXT must match the registered
# template character-for-character: the operator drops a mismatched header or body
# silently while the gateway still answers "200 Success".
# VOX_AUTH_TOKEN=""
# VOX_PROJECT_ID=""
# VOX_SENDER=""                  # DLT header, e.g. GMPE
# VOX_TEMPLATE_ID=""
# VOX_TEMPLATE_TEXT=""           # registered template, with {#var#} for the code
# VOX_BASE_URL=""                # .../sms/v2/send (JSON) or .../sms/v1/send (form)
# VOX_API_VERSION=""             # v1|v2 — only if the URL stops carrying the version
# VOX_DLR_URL=""                 # public URL for delivery receipts
# VOX_EXPIRY_MINUTES="10"        # v1 only
# DEMO_LOGIN="true"              # dev/staging only: surface devOtp even when NODE_ENV=production

# Support-ticket email. When a customer raises a ticket (website Support page /
# mobile app), a notification with all ticket details is emailed to
# SUPPORT_NOTIFY_TO. SMTP unset = the ticket is still saved and shown in the
# admin dashboard; the email is skipped (logged as "SMTP not configured").
# SMTP_HOST=""
# SMTP_PORT="587"                # 465 implies TLS
# SMTP_SECURE="false"            # "true" for implicit TLS (port 465)
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="SwiftLoan Support <support@swiftloan.ai>"
# SUPPORT_NOTIFY_TO="support@swiftloan.ai"   # comma-separated for several inboxes
# ADMIN_DASHBOARD_URL="http://localhost:4001" # base URL for the "Open in admin" link in the email

# Profile photo upload (S3). On the deployed EC2 box, credentials come from the
# instance's IAM role automatically — only AWS_REGION/S3_BUCKET_NAME are needed
# there. For local dev (no instance role available), also set an access key.
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="swiftloan-dev"
# AWS_ACCESS_KEY_ID=""            # local dev only
# AWS_SECRET_ACCESS_KEY=""        # local dev only

# PAN Comprehensive (Aurix) + PII encryption — see src/lib/panVerification.ts.
# PII_ENCRYPTION_KEY: 32 random bytes, hex or base64. REQUIRED in production
# (server refuses to start without it). Generate: openssl rand -hex 32
# Never rotate it by just changing the value — existing PAN records become
# unreadable. Back it up with the other production secrets.
# PII_ENCRYPTION_KEY=""
# PAN_SHARED_POLICY="allow"      # allow | block — same PAN entered from a 2nd account
# PAN_DAILY_LIMIT="5"            # max PAID pan_comprehensive calls per user per 24h
# AURIX_PAN_BASE_URL=""          # defaults to AURIX_OFFERS_BASE_URL
# PAN_LOG_RESPONSE_SHAPE="true"  # debug only: logs pan_comprehensive's Meta +
                                  # outer Data flags (never the nested person
                                  # data) — use on develop to see how Aurix
                                  # shapes different error responses

# ── Install attribution + friend referrals (/dl?ref=CODE) ──
# Public base URL of THIS api — the host in shared referral links.
# PUBLIC_BASE_URL=https://api.swiftloan.ai
# Where /dl sends visitors. DUMMY defaults are used when unset:
#   android -> the hosted test APK;  ios -> a placeholder TestFlight link.
# Use a play.google.com/store/apps/details?id=... URL for Android to switch on the
# deterministic Play Install Referrer automatically.
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.swiftloan.ai
# IOS_STORE_URL=https://testflight.apple.com/join/XXXXXXXX
# ATTRIBUTION_SALT=            # keys the IP/UA hashes; falls back to JWT_REFRESH_SECRET
# ATTRIBUTION_CLICK_TTL_HOURS=48
# ATTRIBUTION_WINDOW_MIN=30    # IP-only matching window
# REFERRAL_ELIGIBLE_DAYS=7     # a referee must be a new account
