# Dependencies
node_modules/
server/node_modules/
admin/node_modules/

# Build outputs
ios/build/
ios/build-sim/
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
.expo/

# Environment files — never commit these
# Env files. The patterns below are deliberately wildcards: exact names like
# `server/.env` did not match a `server/.env.bak-callwindow` copy made while
# testing, which held DATABASE_URL (with password) and the Ello key and was
# staged for commit to this PUBLIC repo. Match any variant, anywhere.
.env
.env.*
!.env.example
!.env.local.example
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example
.env.local
.env.production
server/.env
voiceCredentials.local.js

# Firebase client config. Kept out of the repo because this one is PUBLIC — the
# file embeds a GCP API key, which gitleaks flags (rule: gcp-api-key). Each dev
# and the release pipeline should fetch it from the Firebase console instead.
# The Android build needs it present on disk; it just must not be committed.
android/app/google-services.json
ios/GoogleService-Info.plist
# Firebase service-account keys — real private keys. Never commit these.
**/*-firebase-adminsdk-*.json

# iOS
ios/Pods/
ios/*.xcworkspace/
ios/Podfile.lock

# Ruby (Bundler — pins the cocoapods/xcodeproj gems the iOS build needs).
# vendor/bundle is Bundler's local gem install cache, same category as
# node_modules/ios Pods — regenerated by `bundle install`, never committed.
# Gemfile.lock excluded too, for the same reason Podfile.lock is above.
vendor/bundle/
Gemfile.lock

# Android
android/local.properties
android/app/debug/
android/app/release/
android/app/build/
android/app/.cxx/
android/local.properties
*.keystore
!debug.keystore

# Metro
.metro-health-check*

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Next.js (admin dashboard, website-next)
admin/.next/
admin/out/
website-next/node_modules/
website-next/.next/
website-next/out/

# Jest coverage
coverage/

# APK build outputs (hosted on GitHub Releases, not git — 100MB limit)
dist/
android/app/src/main/assets/index.android.bundle
