{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-aurix",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "server",
        "tsx",
        "server/scripts/mock-aurix.ts"
      ],
      "port": 4010
    },
    {
      "name": "server-mock-aurix",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SMS_PROVIDER=none",
        "DEV_MASTER_OTP=123456",
        "AURIX_AUTH_BASE_URL=http://localhost:4010",
        "AURIX_OFFERS_BASE_URL=http://localhost:4010",
        "AURIX_PAN_BASE_URL=http://localhost:4010",
        "npm",
        "run",
        "dev",
        "--prefix",
        "server"
      ],
      "port": 4000
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "server"
      ],
      "port": 4000
    },
    {
      "name": "admin-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "admin"
      ],
      "port": 4001
    },
    {
      "name": "website-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "website-next"
      ],
      "port": 4002
    }
  ]
}