# Single root env file for local Docker Compose dev (server/ + admin/ +
# website-next/) — see docker-compose.yml, which is the only thing that reads
# this file. No app code loads it directly.
#
# This is separate from — and does NOT replace — server/.env,
# admin/.env.local, website-next/.env.local, which still power the
# non-Docker `npm start` / `npm run dev` workflow each project already had.
# It's also separate from the deployed box's own ~/secrets/server.env, which
# deploy.yml/deploy-prod.yml read directly via SSH-maintained file, not this one.
#
# The mobile app has no runtime .env mechanism at all; its config lives in
# src/config/build.ts instead.

# ───────────────────────── server/ ─────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/swiftloan_db?schema=public"
PORT=4000
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
ACCESS_TTL="900"
REFRESH_TTL_DAYS="30"
NODE_ENV="development"
DEMO_LOGIN="true"

# SMS_PROVIDER="twilio"          # or "msg91"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# MSG91_AUTHKEY=""
# MSG91_TEMPLATE_ID=""

AWS_REGION="ap-south-1"
S3_BUCKET_NAME="swiftloan-dev"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Deploy-time only — consumed once by `npx tsx prisma/seed.integrations.ts`
# (see .github/workflows/deploy.yml) to bootstrap the IntegrationConfig table
# for the app's own voice agent telephony. Not read by the running server
# itself, and not currently wired into docker-compose.yml.
# ELLO_API_KEY=""
# ELLO_AGENT_ID="6a29552a37b4f1561190397a"
# ELLO_AGENT_LEAD_CALLBACK="6a6c630e2f3448069caa1fe5"
# ELLO_BASE_URL="https://api-in.getello.ai"
# ELLO_WEBHOOK_URL="http://dev-api.swiftloan.ai/api/webhooks/ello/call-outcome"

# ───────────────────────── admin/ ─────────────────────────
# Prefixed ADMIN_ — admin and website-next need different values for the same
# NEXT_PUBLIC_* names (different Ello environment each), so a flat key can't
# hold both. docker-compose.yml maps these to the plain NEXT_PUBLIC_* build
# args admin/Dockerfile expects.
ADMIN_NEXT_PUBLIC_API_BASE=http://server:4000
ADMIN_NEXT_PUBLIC_ELLO_API_KEY=ak_REPLACE_ME.setViaEnvOrDashboard
ADMIN_NEXT_PUBLIC_ELLO_ASSISTANT_ID=
ADMIN_NEXT_PUBLIC_ELLO_API_BASE=https://api-in.getello.ai
ADMIN_NEXT_PUBLIC_ELLO_WS_URL=wss://connect-in.getello.ai/ws-ello

# ───────────────────────── website-next/ ─────────────────────────
WEBSITE_NEXT_PUBLIC_API_BASE=http://server:4000
WEBSITE_NEXT_PUBLIC_ELLO_API_KEY=ak_REPLACE_ME.setViaEnvOrDashboard
WEBSITE_NEXT_PUBLIC_ELLO_ASSISTANT_ID=
WEBSITE_NEXT_PUBLIC_ELLO_API_BASE=https://api-in.getello.ai
WEBSITE_NEXT_PUBLIC_ELLO_WS_URL=wss://connect-in.getello.ai/ws-ello

# website-next-only, no collision with admin — passed through unprefixed.
# Currently blank in the real .env too (Upshot isn't actively configured).
NEXT_PUBLIC_UPSHOT_APP_ID=
NEXT_PUBLIC_UPSHOT_OWNER_ID=
NEXT_PUBLIC_UPSHOT_SDK_URL=https://cdn.goupshot.com/UpshotWebSDK/v1.4/upshot.min.js
NEXT_PUBLIC_UPSHOT_DATA_REGION=
