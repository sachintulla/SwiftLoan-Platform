# Base URL of the existing SwiftLoan API (server/). The dashboard calls it from the browser.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ── Ello voice-navigation widget (optional) ──
# Lets an operator drive the dashboard by voice. Leave blank to hide the widget.
# The assistant MUST be configured as "Native Mode (Gemini Live)" on the ello
# dashboard, with a system prompt that instructs it to call the navigation tools.
NEXT_PUBLIC_ELLO_API_KEY=
NEXT_PUBLIC_ELLO_ASSISTANT_ID=
NEXT_PUBLIC_ELLO_API_BASE=https://api-dev.getello.ai
NEXT_PUBLIC_ELLO_WS_URL=wss://connect-dev.getello.ai/ws-ello
