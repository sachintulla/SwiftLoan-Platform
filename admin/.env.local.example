# For LOCAL dev only. The deployed boxes get these from GitHub Actions repo
# Variables/Secrets (Settings > Secrets and variables > Actions, prefixed
# ADMIN_*), passed as --build-arg in .github/workflows/deploy*.yml — update
# values there, not by editing a .env.local file on a box.

# Base URL of the existing SwiftLoan API (server/). The dashboard calls it from the browser.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ── Ello voice-navigation widget ──
# Lets an operator drive the dashboard by voice. Copy this file to .env.local
# and restart the dev server; with the key blank the widget hides itself.
# The assistant MUST be configured as "Native Mode (Gemini Live)" on the ello
# dashboard, or it will talk but never call the navigation tools.
#
# These are the same values render.yaml deploys with (Ello DEV), verified
# working 2026-07-31. Do NOT switch to the *-stage hosts:
# connect-in.getello.ai does not resolve, so the socket dies with code 1006
# while the HTTPS publish call still returns 200 — which reads like a client
# bug rather than a dead host.
NEXT_PUBLIC_ELLO_API_KEY=ak_REPLACE_ME.setViaEnvOrDashboard
NEXT_PUBLIC_ELLO_ASSISTANT_ID=6a64d273a4fc43f6203cd3cc
NEXT_PUBLIC_ELLO_API_BASE=https://api-in.getello.ai
NEXT_PUBLIC_ELLO_WS_URL=wss://connect-in.getello.ai/ws-ello
